# Copy to `.env` and fill in the key. Never commit `.env`.

# Required: OpenAI API key used for answers and embeddings.
OPENAI_API_KEY=

# Models. If your key lacks access to the gpt-5.4 family, use gpt-4.1-mini for both.
WELLSCOPE_CHAT_MODEL=gpt-5.4-mini
WELLSCOPE_ANALYZER_MODEL=gpt-5.4-nano
WELLSCOPE_EMBEDDING_MODEL=text-embedding-3-small

# Where source documents are read from, and where JSON and the database are written.
WELLSCOPE_DATA_DIR=./data/raw
WELLSCOPE_OUTPUT_DIR=./data/processed

# Web server (binds to localhost by default).
WELLSCOPE_HOST=127.0.0.1
WELLSCOPE_PORT=8000

# Limits.
WELLSCOPE_MAX_QUESTION_CHARS=1000
WELLSCOPE_RATE_LIMIT_PER_MIN=20
WELLSCOPE_LLM_TIMEOUT_S=60
WELLSCOPE_CONTEXT_TOKEN_BUDGET=16000

# Logging. Question text is only logged when explicitly enabled.
WELLSCOPE_LOG_LEVEL=INFO
WELLSCOPE_LOG_QUESTIONS=false
